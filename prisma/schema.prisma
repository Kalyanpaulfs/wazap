generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String    @id @default(cuid())
  email                       String    @unique
  password                    String?
  googleSubject               String?   @unique
  sessionVersion              Int       @default(0)
  name                        String?
  plan                        String    @default("free")
  planExpiresAt               DateTime?
  isAdmin                     Boolean   @default(false)
  activeWorkspaceId           String?
  expiryReminderSentFor       DateTime?
  trialStartedAt              DateTime?
  trialEndsAt                 DateTime?
  trialPlan                   String?
  trialReminderSentAt         DateTime?
  accountDeletionRequestedAt  DateTime?
  accountDeletionScheduledFor DateTime?
  marketingOptOutAt           DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  dailyUsage               DailyUsage[]
  payments                 Payment[]
  rotatorLinks             RotatorLink[]
  adLinks                  AdLink[]
  linktreePages            LinktreePage[]
  contactLists             ContactList[]
  scheduledSends           ScheduledSend[]
  shortLinks               ShortLink[]
  catalogPages             CatalogPage[]
  catalogOrders            CatalogOrder[]
  funnelEvents             FunnelEvent[]
  marketplaceReviews       MarketplaceReview[]
  leads                    Lead[]
  siteVisits               SiteVisit[]
  outboundEmails           OutboundEmail[]
  passwordResetTokens      PasswordResetToken[]
  conversationStarts       ConversationStart[]
  ownedWorkspaces          Workspace[]           @relation("WorkspaceOwner")
  workspaceMemberships     WorkspaceMember[]
  workspaceInvitesSent     WorkspaceInvitation[] @relation("WorkspaceInviter")
  workspaceInvitesAccepted WorkspaceInvitation[] @relation("WorkspaceAcceptor")

  @@index([accountDeletionScheduledFor])
  securityMfa SecurityMfa?
  securitySubscriptionStates SecuritySubscriptionState[]
  securityBillingState SecurityUserBilling?
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, usedAt])
}

model Workspace {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  ownerId                    String
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  owner                      User                        @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                    WorkspaceMember[]
  invitations                WorkspaceInvitation[]
  leads                      Lead[]
  conversationStarts         ConversationStart[]
  inboxConversations         InboxConversation[]
  inboxTasks                 InboxTask[]
  inboxEvents                InboxEvent[]
  aiAgents                   AiAgent[]
  aiKnowledge                AiKnowledge[]
  aiRuns                     AiRun[]
  aiDrafts                   AiDraft[]
  aiHandoffs                 AiHandoff[]
  aiEvaluations              AiEvaluation[]
  aiExecutionPaused          Boolean                     @default(false)
  aiExecutionPausedAt        DateTime?
  aiExecutionPauseReason     String?
  apiKeys                    ApiKey[]
  apiRequestLogs             ApiRequestLog[]
  apiIdempotencyRecords      ApiIdempotencyRecord[]
  webhookEndpoints           WebhookEndpoint[]
  marketplacePublisher       MarketplacePublisher?
  marketplaceInstalls        MarketplaceInstall[]
  partnerAccount             PartnerAccount?
  partnerAttributions        PartnerAttribution[]        @relation("AttributedWorkspace")
  claimedPartnerTouches      PartnerReferralTouch[]      @relation("ClaimedPartnerTouch")
  channelConnections         ChannelConnection[]
  channelEvents              ChannelEvent[]
  whatsappTemplates          WhatsAppTemplate[]
  whatsappConsents           WhatsAppConsent[]
  whatsappCampaigns          WhatsAppCampaign[]
  whatsappCampaignRecipients WhatsAppCampaignRecipient[]
  whatsappMigrations         WhatsAppMigration[]
  automationRules            AutomationRule[]
  automationRuns             AutomationRun[]
  operationalSnapshots       OperationalSnapshot[]
  operationalIncidents       OperationalIncident[]
  auditEvents                WorkspaceAuditEvent[]

  @@index([ownerId])
}

model WorkspaceAuditEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  eventType    String
  actorUserId  String?
  targetUserId String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([eventType, createdAt])
}

model WorkspaceMember {
  id                        String                @id @default(cuid())
  workspaceId               String
  userId                    String
  role                      String                @default("member")
  createdAt                 DateTime              @default(now())
  workspace                 Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedConversations     InboxConversation[]   @relation("InboxAssignee")
  sentInboxMessages         InboxMessage[]        @relation("InboxMessageSender")
  inboxNotes                InboxNote[]           @relation("InboxNoteAuthor")
  assignedInboxTasks        InboxTask[]           @relation("InboxTaskAssignee")
  createdInboxTasks         InboxTask[]           @relation("InboxTaskCreator")
  inboxEvents               InboxEvent[]          @relation("InboxEventActor")
  reviewedAiDrafts          AiDraft[]             @relation("AiDraftReviewer")
  assignedAiHandoffs        AiHandoff[]           @relation("AiHandoffAssignee")
  resolvedAiHandoffs        AiHandoff[]           @relation("AiHandoffResolver")
  createdApiKeys            ApiKey[]              @relation("ApiKeyCreator")
  createdWebhookEndpoints   WebhookEndpoint[]     @relation("WebhookEndpointCreator")
  marketplaceInstalls       MarketplaceInstall[]  @relation("MarketplaceInstaller")
  createdChannelConnections ChannelConnection[]   @relation("ChannelConnectionCreator")
  createdAutomationRules    AutomationRule[]      @relation("AutomationRuleCreator")
  ownedOperationalIncidents OperationalIncident[] @relation("OperationalIncidentOwner")
  incidentUpdates           IncidentUpdate[]      @relation("IncidentUpdateActor")

  @@unique([workspaceId, userId])
  @@index([userId, createdAt])
}

model WorkspaceInvitation {
  id           String    @id @default(cuid())
  workspaceId  String
  email        String
  role         String    @default("member")
  token        String    @unique
  status       String    @default("pending")
  expiresAt    DateTime
  invitedById  String
  acceptedById String?
  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User      @relation("WorkspaceInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy   User?     @relation("WorkspaceAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([expiresAt, status])
}

model OutboundEmail {
  id                String    @id @default(cuid())
  userId            String?
  recipient         String
  type              String
  subject           String
  html              String
  status            String    @default("queued")
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  lastError         String?
  provider          String?
  providerMessageId String?   @unique
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

model SiteVisit {
  id        String   @id @default(cuid())
  userId    String?
  country   String
  language  String
  path      String
  source    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([country, createdAt])
  @@index([source, createdAt])
  @@index([userId, createdAt])
}

model Lead {
  id                 String              @id @default(cuid())
  userId             String
  workspaceId        String?
  name               String
  phone              String
  email              String?
  source             String              @default("Manual")
  campaign           String?
  status             String              @default("new")
  owner              String?
  estimatedValue     Float?
  nextFollowUpAt     DateTime?
  lastContactedAt    DateTime?
  notes              String              @default("")
  currency           String              @default("USD")
  closedAt           DateTime?
  lostReason         String?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  activities         LeadActivity[]
  conversationStarts ConversationStart[]
  catalogOrders      CatalogOrder[]
  inboxConversations InboxConversation[]

  @@index([userId, status])
  @@index([userId, nextFollowUpAt])
  @@index([userId, source])
  @@index([userId, archivedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, nextFollowUpAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  type      String
  body      String?
  metadata  Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([type, createdAt])
}

model ConversationStart {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String?
  leadId      String?
  channel     String     @default("whatsapp")
  assetType   String
  assetId     String?
  assetName   String?
  source      String?
  campaign    String?
  destination String?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  lead        Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, source, createdAt])
  @@index([assetType, assetId, createdAt])
  @@index([leadId, createdAt])
  @@index([workspaceId, createdAt])
}

model InboxConversation {
  id                  String             @id @default(cuid())
  workspaceId         String
  leadId              String?
  channel             String             @default("whatsapp")
  channelConnectionId String?
  externalThreadId    String?
  contactName         String
  contactAddress      String
  status              String             @default("open")
  priority            String             @default("normal")
  assignedMemberId    String?
  unreadCount         Int                @default(0)
  lastMessageAt       DateTime           @default(now())
  lastMessagePreview  String?
  firstResponseAt     DateTime?
  resolvedAt          DateTime?
  tags                String[]           @default([])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead                Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  assignedMember      WorkspaceMember?   @relation("InboxAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  channelConnection   ChannelConnection? @relation(fields: [channelConnectionId], references: [id], onDelete: SetNull)
  messages            InboxMessage[]
  notes               InboxNote[]
  tasks               InboxTask[]
  events              InboxEvent[]
  aiRuns              AiRun[]
  aiDrafts            AiDraft[]
  aiHandoffs          AiHandoff[]
  channelEvents       ChannelEvent[]

  @@unique([workspaceId, channel, contactAddress])
  @@index([workspaceId, status, lastMessageAt])
  @@index([workspaceId, assignedMemberId, status])
  @@index([workspaceId, channelConnectionId, status])
  @@index([leadId])
}

model InboxMessage {
  id                     String            @id @default(cuid())
  conversationId         String
  direction              String
  senderType             String
  senderMemberId         String?
  providerMessageId      String?
  idempotencyKeyHash     String?
  idempotencyRequestHash String?
  text                   String
  deliveryStatus         String            @default("recorded")
  sentAt                 DateTime          @default(now())
  readAt                 DateTime?
  createdAt              DateTime          @default(now())
  conversation           InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderMember           WorkspaceMember?  @relation("InboxMessageSender", fields: [senderMemberId], references: [id], onDelete: SetNull)
  channelEvent           ChannelEvent?

  @@unique([providerMessageId])
  @@unique([idempotencyKeyHash])
  @@index([conversationId, sentAt])
  @@index([deliveryStatus, createdAt])
}

model ChannelConnection {
  id                     String              @id @default(cuid())
  workspaceId            String
  createdByMemberId      String?
  channel                String
  provider               String              @default("custom_bridge")
  displayName            String
  externalAccountId      String?
  status                 String              @default("pending_verification")
  capabilities           String[]            @default(["receive"])
  signingSecretEncrypted String
  accessTokenEncrypted   String?
  secretPrefix           String
  webhookPathToken       String              @unique
  config                 Json?
  lastVerifiedAt         DateTime?
  lastEventAt            DateTime?
  lastError              String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  workspace              Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByMember        WorkspaceMember?    @relation("ChannelConnectionCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  conversations          InboxConversation[]
  events                 ChannelEvent[]
  whatsappTemplates      WhatsAppTemplate[]
  whatsappCampaigns      WhatsAppCampaign[]

  @@index([workspaceId, status, channel])
  @@index([workspaceId, provider])
}

model WhatsAppTemplate {
  id                 String             @id @default(cuid())
  workspaceId        String
  connectionId       String
  externalTemplateId String?
  name               String
  language           String             @default("en")
  category           String
  status             String             @default("draft")
  components         Json
  rejectionReason    String?
  lastSyncedAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection         ChannelConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  campaigns          WhatsAppCampaign[]

  @@unique([connectionId, name, language])
  @@index([workspaceId, status, updatedAt])
}

model WhatsAppConsent {
  id             String    @id @default(cuid())
  workspaceId    String
  contactAddress String
  status         String    @default("opted_in")
  source         String
  proof          String?
  capturedAt     DateTime  @default(now())
  optedOutAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, contactAddress])
  @@index([workspaceId, status, updatedAt])
}

model WhatsAppCampaign {
  id                String                      @id @default(cuid())
  workspaceId       String
  connectionId      String
  templateId        String
  createdByMemberId String
  name              String
  status            String                      @default("draft")
  audience          Json
  scheduledFor      DateTime?
  audienceCount     Int                         @default(0)
  eligibleCount     Int                         @default(0)
  sentCount         Int                         @default(0)
  deliveredCount    Int                         @default(0)
  readCount         Int                         @default(0)
  failedCount       Int                         @default(0)
  optOutCount       Int                         @default(0)
  lastError         String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  workspace         Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection        ChannelConnection           @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  template          WhatsAppTemplate            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients        WhatsAppCampaignRecipient[]

  @@index([workspaceId, status, createdAt])
  @@index([connectionId, scheduledFor])
}

model WhatsAppCampaignRecipient {
  id                String           @id @default(cuid())
  workspaceId       String
  campaignId        String
  contactAddress    String
  status            String           @default("queued")
  exclusionReason   String?
  providerMessageId String?          @unique
  lastError         String?
  attemptedAt       DateTime?
  acceptedAt        DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign          WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactAddress])
  @@index([campaignId, status, createdAt])
  @@index([workspaceId, status, updatedAt])
}

model WhatsAppMigration {
  id                String    @id @default(cuid())
  workspaceId       String
  createdByMemberId String
  sourceProvider    String
  status            String    @default("draft")
  mode              String    @default("dry_run")
  summary           Json
  lastError         String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
}

model ChannelEvent {
  id                String             @id @default(cuid())
  workspaceId       String
  connectionId      String
  conversationId    String?
  messageId         String?            @unique
  providerEventId   String
  eventType         String
  status            String             @default("received")
  normalizedPayload Json?
  errorCode         String?
  errorMessage      String?
  receivedAt        DateTime           @default(now())
  processedAt       DateTime?
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection        ChannelConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  conversation      InboxConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message           InboxMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([connectionId, providerEventId])
  @@index([workspaceId, status, receivedAt])
  @@index([connectionId, receivedAt])
}

model AutomationRule {
  id                String           @id @default(cuid())
  workspaceId       String
  createdByMemberId String?
  name              String
  trigger           String
  status            String           @default("draft")
  runMode           String           @default("dry_run")
  conditions        Json
  actions           Json
  runCount          Int              @default(0)
  successCount      Int              @default(0)
  failureCount      Int              @default(0)
  lastRunAt         DateTime?
  lastError         String?
  archivedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByMember   WorkspaceMember? @relation("AutomationRuleCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  runs              AutomationRun[]

  @@index([workspaceId, status, trigger])
  @@index([workspaceId, archivedAt, updatedAt])
  @@index([workspaceId, updatedAt])
}

model AutomationRun {
  id            String         @id @default(cuid())
  workspaceId   String
  ruleId        String
  eventKey      String
  trigger       String
  entityType    String?
  entityId      String?
  status        String         @default("started")
  context       Json?
  actionResults Json?
  errorCode     String?
  errorMessage  String?
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rule          AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventKey])
  @@index([workspaceId, status, startedAt])
  @@index([workspaceId, trigger, startedAt])
  @@index([entityType, entityId, startedAt])
}

model OperationalSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  status      String
  metrics     Json
  issues      Json
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([status, createdAt])
}

model OperationalIncident {
  id               String           @id @default(cuid())
  workspaceId      String
  ownerMemberId    String?
  title            String
  summary          String           @default("")
  impact           String           @default("")
  severity         String
  status           String           @default("investigating")
  source           String           @default("manual")
  sourceKey        String?
  responseTargetAt DateTime
  nextUpdateAt     DateTime
  acknowledgedAt   DateTime?
  escalatedAt      DateTime?
  lastObservedAt   DateTime?
  resolvedAt       DateTime?
  resolution       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerMember      WorkspaceMember? @relation("OperationalIncidentOwner", fields: [ownerMemberId], references: [id], onDelete: SetNull)
  updates          IncidentUpdate[]

  @@index([workspaceId, status, severity, createdAt])
  @@index([workspaceId, sourceKey, status])
  @@index([ownerMemberId, status])
  @@index([status, responseTargetAt])
}

model IncidentUpdate {
  id            String              @id @default(cuid())
  incidentId    String
  actorMemberId String?
  status        String
  message       String
  audience      String              @default("internal")
  createdAt     DateTime            @default(now())
  incident      OperationalIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actorMember   WorkspaceMember?    @relation("IncidentUpdateActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([audience, createdAt])
}

model InboxNote {
  id             String            @id @default(cuid())
  conversationId String
  authorMemberId String?
  body           String
  createdAt      DateTime          @default(now())
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorMember   WorkspaceMember?  @relation("InboxNoteAuthor", fields: [authorMemberId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model InboxTask {
  id                String             @id @default(cuid())
  workspaceId       String
  conversationId    String?
  title             String
  status            String             @default("open")
  priority          String             @default("normal")
  dueAt             DateTime?
  assignedMemberId  String?
  createdByMemberId String?
  completedAt       DateTime?
  archivedAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation      InboxConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedMember    WorkspaceMember?   @relation("InboxTaskAssignee", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  createdByMember   WorkspaceMember?   @relation("InboxTaskCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, dueAt])
  @@index([workspaceId, archivedAt, updatedAt])
  @@index([conversationId, status])
  @@index([assignedMemberId, status])
}

model InboxEvent {
  id             String            @id @default(cuid())
  workspaceId    String
  conversationId String
  actorMemberId  String?
  type           String
  metadata       Json?
  createdAt      DateTime          @default(now())
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   InboxConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actorMember    WorkspaceMember?  @relation("InboxEventActor", fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([workspaceId, type, createdAt])
}

model AiAgent {
  id                   String         @id @default(cuid())
  workspaceId          String
  name                 String
  roleType             String
  status               String         @default("draft")
  responseMode         String         @default("draft_only")
  instructions         String
  tone                 String         @default("professional")
  language             String         @default("auto")
  allowedTopics        String[]       @default([])
  prohibitedTopics     String[]       @default([])
  escalationKeywords   String[]       @default([])
  requireHumanFor      String[]       @default([])
  maxMessagesPerThread Int            @default(5)
  archivedAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  workspace            Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs                 AiRun[]
  drafts               AiDraft[]
  handoffs             AiHandoff[]
  evaluations          AiEvaluation[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, archivedAt, updatedAt])
  @@index([workspaceId, roleType])
}

model AiEvaluation {
  id                 String    @id @default(cuid())
  workspaceId        String
  agentId            String
  suiteVersion       String    @default("v1")
  roleType           String
  status             String    @default("running")
  casesTotal         Int       @default(0)
  casesPassed        Int       @default(0)
  accuracyScore      Float?
  refusalScore       Float?
  escalationScore    Float?
  hallucinationScore Float?
  averageLatencyMs   Int?
