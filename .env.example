# Local development only; no production credentials.
DATABASE_URL="postgresql://wazap_dev:replace_with_local_password@localhost:5432/wazap_dev?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Optional development Google OAuth client.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional email sandbox.
EMAIL_FROM=""
BREVO_API_KEY=""
BREVO_SENDER_ID=""
RESEND_API_KEY=""

# Optional Meta sandbox.
META_APP_ID=""
META_APP_SECRET=""
META_CONFIG_ID=""
META_GRAPH_VERSION="v24.0"

# Additional integration variables are documented in their lib modules.
# Configure only the sandbox features you intend to test.

# Optional: fake AI answers for the support chat widget, so the "needs a
# human" handoff flow can be tested locally without the support-worker
# socket running. Dev only - lib/codex-support-provider.ts ignores this in
# production regardless of its value.
WAZAP_SUPPORT_FAKE_AI=""

# Optional: path to the DB-IP "IP to City Lite" mmdb for the Audience
# feature (lib/geo-city.ts). Too big for git - download it with
# scripts/update-geoip-city.sh. Missing/unset just disables city lookups
# (device/OS/country still work from the user-agent and the existing
# country-only mmdb) - never breaks a click.
# GEOIP_CITY_DB_PATH="D:/wazap/geoip/dbip-city-lite.mmdb"
