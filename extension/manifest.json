{
  "manifest_version": 3,
  "name": "Wazap — WhatsApp Quick Messenger",
  "version": "1.0.0",
  "description": "Message anyone on WhatsApp instantly — no need to save their number. Free, fast, works everywhere.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wazap — Open WhatsApp Chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": []
}
